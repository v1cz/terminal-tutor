{
  "permissions": {
    "allow": ["Bash", "Read"],
    "deny": ["WebFetch", "WebSearch"],
    "disableAutoMode": "disable"
  },
  "showTurnDuration": false,
  "promptSuggestionEnabled": false,
  "spinnerTipsEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Student's screen (right pane):\"; tmux capture-pane -p -t school:0.1 -S -30"
          }
        ]
      }
    ]
  }
}
